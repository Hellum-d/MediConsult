<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<!--
  pacientes.fxml — CLINEX Gestión de Pacientes
  Diseño basado en: stitch_clinex_medical_ui_design/pacientes_clinex
  Paleta y estilos: styles.css

  fx:id disponibles para el controller:
    - topBar            : HBox         → barra superior
    - searchField       : TextField    → buscar paciente por nombre/ID
    - statTotalLabel    : Label        → total de pacientes
    - statActivosLabel  : Label        → activos este mes
    - statNuevosLabel   : Label        → nuevos hoy
    - patientGridPane   : FlowPane     → grid de tarjetas de paciente
    - detailPanel       : VBox         → panel lateral deslizante de detalle
    - detailNameLabel   : Label        → nombre del paciente en detalle
    - detailIdLabel     : Label        → ID del paciente en detalle
    - detailContactInfo : VBox         → sección de contacto (teléfono/email)
    - detailAlergias    : FlowPane     → chips de alergias
    - closeDetailBtn    : Button       → cerrar panel de detalle
    - addPatientBtn     : Button       → FAB agregar nuevo paciente
    - navPacientesBtn   : Button       → tab Pacientes (activo)
    - navMedicosBtn     : Button       → tab Médicos
    - navCitasBtn       : Button       → tab Citas
    - navDiagnosticoBtn : Button       → tab Diagnóstico IA
-->

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="pacientesRoot"
            fx:controller="com.mediconsult.beta.controller.PacientesController"
            prefWidth="1280"
            prefHeight="800"
            style="-fx-background-color:#f8f9ff;"
            stylesheets="@styles.css">

    <!-- ═══════════════════════════════════════════════════
         TOP APP BAR
         ═══════════════════════════════════════════════════ -->
    <top>
        <HBox fx:id="topBar" styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">

            <!-- Logo + Título -->
            <fx:include source="header_logo.fxml"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Acciones de la derecha -->
            <Button text="🔔" styleClass="top-bar-icon-btn" onAction="#onNotificaciones"/>
            <Button text="⚙" styleClass="top-bar-icon-btn"/>
            <Label fx:id="avatarCircle"
                   text="U"
                   style="-fx-background-color:#54a3fd; -fx-background-radius:20; -fx-min-width:40; -fx-min-height:40; -fx-max-width:40; -fx-max-height:40; -fx-alignment:center; -fx-font-weight:bold; -fx-text-fill:white; -fx-font-size:14px; -fx-cursor:hand;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════
         CONTENIDO PRINCIPAL
         ═══════════════════════════════════════════════════ -->
    <center>
        <HBox>
            <!-- Área principal scrollable -->
            <ScrollPane HBox.hgrow="ALWAYS"
                        fitToWidth="true"
                        style="-fx-background-color:transparent; -fx-background:#f8f9ff;">
                <content>
                    <VBox spacing="0"
                          style="-fx-background-color:#f8f9ff;">
                        <padding><Insets top="48" right="48" bottom="120" left="48"/></padding>

                        <!-- ── Encabezado de sección ──────────────────── -->
                        <VBox spacing="6">
                            <Label text="Pacientes" styleClass="label-headline-lg"/>
                            <Label text="Directorio de pacientes registrados"
                                   styleClass="label-body-lg"/>
                        </VBox>

                        <Region prefHeight="32"/>

                        <!-- ── Fila de estadísticas ───────────────────── -->
                        <HBox spacing="24">
                            <!-- Total Pacientes -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8"
                                  style="-fx-border-color:rgba(46,134,222,0.15); -fx-border-left-width:4; -fx-border-width:0 0 0 4; -fx-border-color:#2E86DE rgba(46,134,222,0.15) rgba(46,134,222,0.15) rgba(46,134,222,0.15);">
                                <Label text="TOTAL PACIENTES" styleClass="stat-card-label"/>
                                <Label fx:id="statTotalLabel" text="0" styleClass="stat-card-value"/>
                            </VBox>
                            <!-- Activos este mes -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8"
                                  style="-fx-border-color:rgba(46,134,222,0.15); -fx-border-width:0 0 0 4; -fx-border-color:#2E86DE rgba(46,134,222,0.15) rgba(46,134,222,0.15) rgba(46,134,222,0.15);">
                                <Label text="ACTIVOS ESTE MES" styleClass="stat-card-label"/>
                                <Label fx:id="statActivosLabel" text="0" styleClass="stat-card-value"/>
                            </VBox>
                            <!-- Nuevos hoy -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8"
                                  style="-fx-border-color:rgba(46,134,222,0.15); -fx-border-width:0 0 0 4; -fx-border-color:#2E86DE rgba(46,134,222,0.15) rgba(46,134,222,0.15) rgba(46,134,222,0.15);">
                                <Label text="NUEVOS HOY" styleClass="stat-card-label"/>
                                <Label fx:id="statNuevosLabel" text="0" styleClass="stat-card-value"/>
                            </VBox>
                        </HBox>

                        <Region prefHeight="24"/>

                        <!-- ── Barra de búsqueda ───────────────────────── -->
                        <StackPane>
                            <TextField fx:id="searchField"
                                       promptText="Buscar paciente por nombre, ID o teléfono..."
                                       styleClass="search-field"
                                       maxWidth="Infinity"/>
                            <Label text="🔍"
                                   style="-fx-font-size:16px; -fx-text-fill:#73777f; -fx-padding:0 0 0 14;"
                                   StackPane.alignment="CENTER_LEFT"/>
                        </StackPane>

                        <Region prefHeight="24"/>

                        <!-- ── Grid de tarjetas de paciente ───────────── -->
                        <FlowPane fx:id="patientGridPane"
                                  hgap="20"
                                  vgap="20"
                                  prefWrapLength="900">
                            <!--
                              Las tarjetas de paciente se generan dinámicamente
                              desde el controller con el siguiente template visual:

                              VBox (styleClass="item-card", prefWidth=280, spacing=12)
                                ├── HBox (spacing=14, alignment=CENTER_LEFT)
                                │     ├── StackPane (avatar-circle)
                                │     │     └── Label (inicial, styleClass="avatar-circle-label")
                                │     └── VBox (spacing=4)
                                │           ├── HBox → Label (nombre) + Label (tipo sangre, chip-blood-type)
                                │           └── Label (edad + teléfono, body-md)
                                ├── FlowPane (hgap=6, vgap=6) → chips alergias
                                └── Button (styleClass="btn-secondary", text="Ver detalle")

                              Placeholder estático para FXML preview:
                            -->

                            <!-- Tarjeta placeholder 1 -->
                            <VBox styleClass="item-card" prefWidth="280" spacing="12">
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane minWidth="56" minHeight="56" maxWidth="56" maxHeight="56"
                                               styleClass="avatar-circle">
                                        <Label text="A" styleClass="avatar-circle-label"/>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Ana Martínez" styleClass="item-card-name"/>
                                            <Label text="O+" styleClass="chip-blood-type"/>
                                        </HBox>
                                        <Label text="34 años • 310 456 7890" styleClass="item-card-sub"/>
                                    </VBox>
                                </HBox>
                                <FlowPane hgap="6" vgap="6">
                                    <Label text="Penicilina" styleClass="chip-allergy"/>
                                    <Label text="Polvo" styleClass="chip-allergy"/>
                                </FlowPane>
                                <Button text="Ver detalle" styleClass="btn-secondary"
                                        maxWidth="Infinity"/>
                            </VBox>

                            <!-- Tarjeta placeholder 2 -->
                            <VBox styleClass="item-card" prefWidth="280" spacing="12">
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane minWidth="56" minHeight="56" maxWidth="56" maxHeight="56"
                                               styleClass="avatar-circle">
                                        <Label text="C" styleClass="avatar-circle-label"/>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Carlos Gómez" styleClass="item-card-name"/>
                                            <Label text="A-" styleClass="chip-blood-type"/>
                                        </HBox>
                                        <Label text="45 años • 312 987 6543" styleClass="item-card-sub"/>
                                    </VBox>
                                </HBox>
                                <FlowPane hgap="6" vgap="6">
                                    <Label text="Sin alergias" styleClass="chip-neutral"/>
                                </FlowPane>
                                <Button text="Ver detalle" styleClass="btn-secondary"
                                        maxWidth="Infinity"/>
                            </VBox>

                        </FlowPane>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- ── Panel Lateral de Detalle (oculto por defecto) ─ -->
            <VBox fx:id="detailPanel"
                  styleClass="detail-panel"
                  managed="false"
                  visible="false"
                  HBox.hgrow="NEVER">

                <!-- Encabezado del panel -->
                <HBox styleClass="detail-panel-header" alignment="CENTER_LEFT" spacing="0">
                    <Label text="Detalles del Paciente" styleClass="detail-panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="closeDetailBtn"
                            text="✕"
                            style="-fx-background-color:transparent; -fx-text-fill:white; -fx-font-size:18px; -fx-cursor:hand; -fx-background-radius:20; -fx-padding:4 8 4 8;"
                            onAction="#onCloseDetail"/>
                </HBox>

                <!-- Contenido del panel -->
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent; -fx-background:white;">
                    <content>
                        <VBox spacing="20">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                            <!-- Avatar grande + nombre -->
                            <VBox alignment="CENTER" spacing="8">
                                <StackPane minWidth="80" minHeight="80" maxWidth="80" maxHeight="80"
                                           style="-fx-background-color:#1a3a5c; -fx-background-radius:40; -fx-alignment:center;"
                                           StackPane.alignment="CENTER">
                                    <Label fx:id="detailAvatarLabel"
                                           text="A"
                                           style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                                </StackPane>
                                <Label fx:id="detailNameLabel"
                                       text="Nombre del Paciente"
                                       styleClass="label-headline-sm"/>
                                <Label fx:id="detailIdLabel"
                                       text="ID: —"
                                       styleClass="label-body-md"/>
                            </VBox>

                            <Separator style="-fx-background-color:rgba(195,198,207,0.5);"/>

                            <!-- Sección: Información de Contacto -->
                            <VBox fx:id="detailContactInfo" spacing="12">
                                <Label text="INFORMACIÓN DE CONTACTO"
                                       styleClass="detail-section-label"/>
                                <GridPane hgap="16" vgap="8">
                                    <Label text="Teléfono" styleClass="detail-field-label"
                                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <Label fx:id="detailTelefonoLabel" text="—"
                                           styleClass="detail-field-value"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <Label text="Edad" styleClass="detail-field-label"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label fx:id="detailEdadLabel" text="—"
                                           styleClass="detail-field-value"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                </GridPane>
                            </VBox>

                            <Separator style="-fx-background-color:rgba(195,198,207,0.5);"/>

                            <!-- Sección: Datos Médicos -->
                            <VBox spacing="12">
                                <Label text="DATOS MÉDICOS" styleClass="detail-section-label"/>
                                <GridPane hgap="16" vgap="8">
                                    <Label text="Tipo de Sangre" styleClass="detail-field-label"
                                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <Label fx:id="detailSangreLabel" text="—"
                                           styleClass="detail-field-value"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                </GridPane>
                                <Label text="Alergias" styleClass="detail-field-label"/>
                                <FlowPane fx:id="detailAlergias" hgap="6" vgap="6">
                                    <Label text="Sin información" styleClass="chip-neutral"/>
                                </FlowPane>
                            </VBox>

                            <Separator style="-fx-background-color:rgba(195,198,207,0.5);"/>

                            <!-- Sección: Historial -->
                            <VBox spacing="8">
                                <Label text="HISTORIAL CLÍNICO" styleClass="detail-section-label"/>
                                <TextArea fx:id="detailHistorialArea"
                                          editable="false"
                                          wrapText="true"
                                          prefRowCount="5"
                                          styleClass="text-area-clinex"
                                          promptText="Sin historial registrado."/>
                            </VBox>

                            <!-- Botón acción -->
                            <Button fx:id="verHistorialBtn"
                                    text="Ver Historia Clínica Completa"
                                    onAction="#onVerHistorialCompleto"
                                    styleClass="btn-primary"
                                    maxWidth="Infinity"/>

                        </VBox>
                    </content>
                </ScrollPane>

            </VBox>
        </HBox>
    </center>

    <!-- ═══════════════════════════════════════════════════
         BOTTOM: FAB + Navegación inferior
         ═══════════════════════════════════════════════════ -->
    <bottom>
        <StackPane style="-fx-background-color:transparent; -fx-padding:0 0 20 0;"
                   pickOnBounds="false">

            <!-- Navegación inferior (centrada) -->
            <HBox fx:id="bottomNav"
                  styleClass="bottom-nav"
                  alignment="CENTER"
                  spacing="4"
                  maxWidth="700"
                  StackPane.alignment="BOTTOM_CENTER"
                  style="-fx-background-color:#002444; -fx-background-radius:30; -fx-padding:10 24 10 24; -fx-effect:dropshadow(gaussian,rgba(0,36,68,0.25),16,0,0,4); -fx-translate-y:-20;">

                <Button fx:id="navPacientesBtn"
                        text="👥  Pacientes"
                        styleClass="nav-tab-active"
                        onAction="#onNavPacientes"/>
                <Button fx:id="navMedicosBtn"
                        text="⚕  Médicos"
                        styleClass="nav-tab"
                        onAction="#onNavMedicos"/>
                <Button fx:id="navCitasBtn"
                        text="📅  Citas"
                        styleClass="nav-tab"
                        onAction="#onNavCitas"/>
                <Button fx:id="navRemisionesBtn"
                        text="🔗  Remisiones"
                        styleClass="nav-tab"
                        onAction="#onNavRemisiones"/>
                <Button fx:id="navListaEsperaBtn"
                        text="⏳  Lista de Espera"
                        styleClass="nav-tab"
                        onAction="#onNavListaEspera"/>
            </HBox>

            <!-- FAB (flotante, abajo a la derecha) -->
            <Button fx:id="addPatientBtn"
                    text="+"
                    styleClass="fab"
                    StackPane.alignment="BOTTOM_RIGHT"
                    style="-fx-translate-x:-32; -fx-translate-y:-80; -fx-font-size:28px;"
                    onAction="#onAddPatient"/>

        </StackPane>
    </bottom>

</BorderPane>
