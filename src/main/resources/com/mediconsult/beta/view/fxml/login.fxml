<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<!--
  login.fxml — CLINEX Login Screen
  Diseño basado en: stitch_clinex_medical_ui_design/login_clinex
  Paleta y estilos: styles.css

  fx:id disponibles para el controller:
    - usuarioField      : TextField    → input usuario/correo
    - passwordField     : PasswordField → input contraseña
    - togglePasswordBtn : Button       → mostrar/ocultar contraseña
    - loginBtn          : Button       → botón "Ingresar"
    - errorLabel        : Label        → mensaje de error
    - brandingPane      : VBox         → panel izquierdo (branding)
    - loginFormPane     : VBox         → panel derecho (formulario)
-->

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="loginRoot"
      fx:controller="com.mediconsult.beta.controller.LoginController"
      prefWidth="1280"
      prefHeight="800"
      styleClass="login-root"
      stylesheets="@styles.css">

    <!-- ═══════════════════════════════════════════════════
         PANEL IZQUIERDO: Branding + Visión (55%)
         ═══════════════════════════════════════════════════ -->
    <VBox fx:id="brandingPane"
          prefWidth="704"
          minWidth="400"
          styleClass="branding-pane"
          spacing="0"
          HBox.hgrow="ALWAYS">

        <!-- Logo + Nombre de marca -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ImageView fitHeight="36"
                       preserveRatio="true"
                       smooth="true">
                <image><Image url="@logo.png"/></image>
            </ImageView>
            <Label text="CLINEX"
                   styleClass="brand-title"/>
        </HBox>

        <!-- Área de características — llenada dinámicamente por LoginController -->
        <VBox fx:id="featureArea" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="0"/>

        <!-- Bloque central de contenido -->
        <VBox spacing="20">
            <Label fx:id="taglineLabel"
                   text="La salud merece tecnología de primer nivel."
                   styleClass="brand-tagline"
                   wrapText="true"/>
            <Label fx:id="subLabel"
                   text="Gestión hospitalaria inteligente para una atención más humana y eficiente."
                   styleClass="brand-sub"
                   wrapText="true"/>
        </VBox>

        <!-- Espaciador -->
        <Region prefHeight="48"/>

        <!-- Stat Pills — valores cargados dinámicamente desde BD por LoginController -->
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <!-- Pill: Pacientes -->
            <HBox styleClass="stat-pill" spacing="10" alignment="CENTER_LEFT">
                <Label text="👥" style="-fx-font-size:16px;"/>
                <Label fx:id="statPacientesLabel" text="— PACIENTES ACTIVOS" styleClass="stat-pill-text"/>
            </HBox>
            <!-- Pill: Médicos -->
            <HBox styleClass="stat-pill" spacing="10" alignment="CENTER_LEFT">
                <Label text="⚕" style="-fx-font-size:16px; -fx-text-fill:#2E86DE;"/>
                <Label fx:id="statMedicosLabel" text="— MÉDICOS DISPONIBLES" styleClass="stat-pill-text"/>
            </HBox>
            <!-- Pill: Especialidades -->
            <HBox styleClass="stat-pill" spacing="10" alignment="CENTER_LEFT">
                <Label text="🏥" style="-fx-font-size:16px;"/>
                <Label fx:id="statEspecialidadesLabel" text="— ESPECIALIDADES" styleClass="stat-pill-text"/>
            </HBox>
        </HBox>

        <!-- Espaciador inferior -->
        <Region prefHeight="32"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════
         PANEL DERECHO: Formulario de Login (45%)
         ═══════════════════════════════════════════════════ -->
    <VBox fx:id="loginFormPane"
          prefWidth="576"
          minWidth="360"
          styleClass="login-panel"
          alignment="CENTER"
          HBox.hgrow="NEVER">

        <!-- Card del formulario -->
        <VBox styleClass="login-card"
              maxWidth="440"
              spacing="0"
              alignment="TOP_CENTER">

            <!-- Encabezado del formulario -->
            <VBox spacing="6" alignment="CENTER">
                <Label text="Iniciar Sesión"
                       styleClass="login-title"/>
                <Label text="Accede a tu panel de control"
                       styleClass="login-subtitle"/>
            </VBox>

            <Region prefHeight="28"/>

            <!-- ─── Campo: Usuario ─────────────────────── -->
            <VBox spacing="6">
                <Label text="USUARIO / CORREO ELECTRÓNICO"
                       styleClass="field-label"/>
                <StackPane>
                    <TextField fx:id="usuarioField"
                               promptText="ej. doctor@clinex.com"
                               styleClass="text-field-clinex"
                               maxWidth="400"/>
                </StackPane>
            </VBox>

            <Region prefHeight="16"/>

            <!-- ─── Campo: Contraseña ──────────────────── -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="CONTRASEÑA" styleClass="field-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="¿Olvidaste tu contraseña?"
                            onAction="#onRecuperarContrasena"
                            style="-fx-background-color:transparent; -fx-border-color:transparent; -fx-font-size:11px; -fx-text-fill:#2E86DE; -fx-cursor:hand; -fx-padding:0;"/>
                </HBox>
                <StackPane>
                    <PasswordField fx:id="passwordField"
                                   promptText="••••••••"
                                   styleClass="password-field-clinex"
                                   maxWidth="400"/>
                    <!-- Botón toggle a la derecha dentro del stack -->
                    <Button fx:id="togglePasswordBtn"
                            text="👁"
                            onAction="#onTogglePassword"
                            style="-fx-background-color:transparent; -fx-cursor:hand; -fx-font-size:14px; -fx-text-fill:#73777f; -fx-padding:0 12 0 0;"
                            StackPane.alignment="CENTER_RIGHT"/>
                </StackPane>
            </VBox>

            <Region prefHeight="8"/>

            <!-- ─── Mensaje de error ───────────────────── -->
            <Label fx:id="errorLabel"
                   text=""
                   styleClass="error-label"
                   wrapText="true"
                   maxWidth="400"
                   style="-fx-min-height:18px;"/>

            <Region prefHeight="16"/>

            <!-- ─── Botón Ingresar ─────────────────────── -->
            <Button fx:id="loginBtn"
                    text="Ingresar  →"
                    onAction="#onLogin"
                    styleClass="btn-primary"
                    maxWidth="400"
                    prefWidth="400"
                    prefHeight="48"
                    style="-fx-font-size:15px;"/>

            <Region prefHeight="24"/>

            <!-- ─── Pie del formulario ─────────────────── -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="¿Primera vez en CLINEX?"
                       style="-fx-font-size:13px; -fx-text-fill:#73777f;"/>
                <Button text="Crear cuenta de paciente"
                        onAction="#onRegistrarse"
                        style="-fx-background-color:transparent; -fx-border-color:transparent; -fx-font-size:13px; -fx-text-fill:#2E86DE; -fx-font-weight:600; -fx-cursor:hand; -fx-padding:0;"/>
            </HBox>

        </VBox>
    </VBox>

</HBox>
