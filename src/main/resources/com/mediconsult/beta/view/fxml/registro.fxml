<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<!--
  registro.fxml — CLINEX Patient Registration Screen
  Controller: RegistroController
-->

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mediconsult.beta.controller.RegistroController"
      prefWidth="1280" prefHeight="800"
      styleClass="login-root"
      stylesheets="@styles.css">

    <!-- ═══════════════════════════════════════════════════
         PANEL IZQUIERDO: Branding (55%)
         ═══════════════════════════════════════════════════ -->
    <VBox prefWidth="704" minWidth="400"
          styleClass="branding-pane" spacing="0"
          HBox.hgrow="ALWAYS">

        <HBox spacing="8" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" preserveRatio="true" smooth="true">
                <image><Image url="@logo.png"/></image>
            </ImageView>
            <Label text="CLINEX" styleClass="brand-title"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox spacing="20" maxWidth="520">
            <Label text="Tu salud, tu historia, tu control."
                   styleClass="brand-tagline" wrapText="true" prefWidth="520"/>
            <Label text="Crea tu cuenta de paciente y accede a todos los servicios médicos de CLINEX de forma rápida y segura."
                   styleClass="brand-sub" wrapText="true" prefWidth="520"/>
        </VBox>

        <Region prefHeight="36"/>

        <VBox spacing="14">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-size:16px; -fx-text-fill:#22c55e; -fx-font-weight:bold;"/>
                <Label text="Historial clínico digital y seguro"
                       style="-fx-font-size:14px; -fx-text-fill:#43474e;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-size:16px; -fx-text-fill:#22c55e; -fx-font-weight:bold;"/>
                <Label text="Diagnóstico preliminar asistido por IA"
                       style="-fx-font-size:14px; -fx-text-fill:#43474e;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-size:16px; -fx-text-fill:#22c55e; -fx-font-weight:bold;"/>
                <Label text="Agendamiento de citas médicas en línea"
                       style="-fx-font-size:14px; -fx-text-fill:#43474e;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-size:16px; -fx-text-fill:#22c55e; -fx-font-weight:bold;"/>
                <Label text="Consulta de órdenes y remisiones médicas"
                       style="-fx-font-size:14px; -fx-text-fill:#43474e;"/>
            </HBox>
        </VBox>

        <Region prefHeight="32"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════
         PANEL DERECHO: Formulario de Registro (45%)
         ═══════════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true"
                HBox.hgrow="NEVER" prefWidth="576" minWidth="360"
                style="-fx-background:rgba(255,255,255,0.5); -fx-background-color:rgba(255,255,255,0.5); -fx-border-color:transparent transparent transparent rgba(195,198,207,0.3); -fx-border-width:0 0 0 1;">

        <VBox alignment="TOP_CENTER" style="-fx-padding:32 48 32 48;">

            <!-- Card del formulario -->
            <VBox styleClass="login-card" maxWidth="440" spacing="0" alignment="TOP_CENTER">

                <!-- Encabezado -->
                <VBox spacing="6" alignment="CENTER">
                    <Label text="Crear Cuenta de Paciente" styleClass="login-title"/>
                    <Label text="Ingresa tus datos para registrarte en CLINEX"
                           styleClass="login-subtitle"/>
                </VBox>

                <Region prefHeight="20"/>

                <!-- ─── SECCIÓN 1: Información Personal ─────────── -->
                <Label text="INFORMACIÓN PERSONAL" styleClass="form-section-title"/>
                <Region prefHeight="10"/>

                <!-- Nombre | Apellido -->
                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <HBox spacing="2">
                            <Label text="Nombre" styleClass="form-label"/>
                            <Label text="*" styleClass="required-star"/>
                        </HBox>
                        <TextField fx:id="nombreField" promptText="Carlos"
                                   styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <HBox spacing="2">
                            <Label text="Apellido" styleClass="form-label"/>
                            <Label text="*" styleClass="required-star"/>
                        </HBox>
                        <TextField fx:id="apellidoField" promptText="Gómez"
                                   styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                </HBox>
                <Region prefHeight="10"/>

                <!-- Edad | Teléfono -->
                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <HBox spacing="2">
                            <Label text="Edad" styleClass="form-label"/>
                            <Label text="*" styleClass="required-star"/>
                        </HBox>
                        <TextField fx:id="edadField" promptText="25"
                                   styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Teléfono" styleClass="form-label"/>
                        <TextField fx:id="telefonoField" promptText="3001234567"
                                   styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                </HBox>
                <Region prefHeight="10"/>

                <!-- Correo -->
                <VBox spacing="6">
                    <Label text="Correo electrónico" styleClass="form-label"/>
                    <TextField fx:id="correoField" promptText="paciente@correo.com"
                               styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                </VBox>
                <Region prefHeight="10"/>

                <!-- Dirección -->
                <VBox spacing="6">
                    <Label text="Dirección" styleClass="form-label"/>
                    <TextField fx:id="direccionField" promptText="Calle, Barrio, Ciudad"
                               styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                </VBox>
                <Region prefHeight="14"/>

                <!-- Divisor -->
                <Region styleClass="form-divider"/>
                <Region prefHeight="14"/>

                <!-- ─── SECCIÓN 2: Datos Clínicos ────────────────── -->
                <Label text="DATOS CLÍNICOS (opcional)" styleClass="form-section-title"/>
                <Region prefHeight="10"/>

                <HBox spacing="12" alignment="TOP_LEFT">
                    <VBox spacing="6">
                        <Label text="Tipo de Sangre" styleClass="form-label"/>
                        <ComboBox fx:id="tipoSangreCombo"
                                  styleClass="combo-box-clinex"
                                  prefWidth="140"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Alergias conocidas" styleClass="form-label"/>
                        <TextField fx:id="alergiasField" promptText="Ej: Penicilina, Polvo..."
                                   styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                </HBox>
                <Region prefHeight="14"/>

                <!-- Divisor -->
                <Region styleClass="form-divider"/>
                <Region prefHeight="14"/>

                <!-- ─── SECCIÓN 3: Credenciales ──────────────────── -->
                <Label text="CREDENCIALES DE ACCESO" styleClass="form-section-title"/>
                <Region prefHeight="10"/>

                <VBox spacing="6">
                    <HBox spacing="2">
                        <Label text="Nombre de usuario" styleClass="form-label"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <TextField fx:id="usernameField" promptText="paciente_01"
                               styleClass="form-field" maxWidth="1.7976931348623157E308"/>
                    <Label text="Sin espacios. Solo letras, números y guiones bajos."
                           styleClass="field-hint"/>
                </VBox>
                <Region prefHeight="10"/>

                <VBox spacing="6">
                    <HBox spacing="2">
                        <Label text="Contraseña" styleClass="form-label"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <PasswordField fx:id="passwordField" promptText="Mínimo 6 caracteres"
                                   styleClass="password-field-clinex"
                                   maxWidth="1.7976931348623157E308"/>
                </VBox>
                <Region prefHeight="10"/>

                <VBox spacing="6">
                    <HBox spacing="2">
                        <Label text="Confirmar contraseña" styleClass="form-label"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <PasswordField fx:id="confirmPasswordField" promptText="Repite tu contraseña"
                                   styleClass="password-field-clinex"
                                   maxWidth="1.7976931348623157E308"/>
                </VBox>
                <Region prefHeight="8"/>

                <!-- Mensaje de error -->
                <Label fx:id="errorLabel" text=""
                       styleClass="error-label"
                       wrapText="true" maxWidth="400"
                       style="-fx-min-height:18px;"
                       visible="false" managed="false"/>

                <Region prefHeight="12"/>

                <!-- Nota campos obligatorios -->
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="*" styleClass="required-star"/>
                    <Label text="Campos obligatorios" styleClass="field-hint"/>
                </HBox>
                <Region prefHeight="14"/>

                <!-- Botón principal -->
                <Button fx:id="registrarBtn" text="Crear Cuenta  →"
                        onAction="#onRegistrar"
                        styleClass="btn-primary"
                        maxWidth="400" prefWidth="400" prefHeight="48"
                        style="-fx-font-size:15px;"/>

                <Region prefHeight="16"/>

                <!-- Link volver al login -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="¿Ya tienes una cuenta?"
                           style="-fx-font-size:13px; -fx-text-fill:#73777f;"/>
                    <Button text="Inicia sesión"
                            onAction="#onVolverLogin"
                            style="-fx-background-color:transparent; -fx-border-color:transparent; -fx-font-size:13px; -fx-text-fill:#2E86DE; -fx-font-weight:600; -fx-cursor:hand; -fx-padding:0;"/>
                </HBox>

            </VBox>

            <Region prefHeight="32"/>
        </VBox>
    </ScrollPane>

</HBox>
